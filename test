# Q2 GRPO schedule ablation commands
# Run from repo root: C:\Users\donga\OneDrive\Documents\GitHub\ms-swift
# Metrics used from q2_eval_metrics.json:
#   accuracy.MeanFieldAcc_macro
#   consistency.CoverageAvg
#   caption_quality_en.BERTScore_F1
#
# Note:
# For a Q2 schedule ablation, evaluating the raw GRPO2 training checkpoint directly is logically clean,
# because the compared object is the learned Query-2 adapter under each schedule.
# swift infer can load args.json from a checkpoint path.

# ============================================================
# 0) Shared paths
# ============================================================

export Q2_TRAIN_JSON="/datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/data_GRPO2_Q2/grpo2_train_sft_q2_swift.json"
export Q2_VAL_JSON="/datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/data_GRPO2_Q2/grpo2_val.json"
# Use the same SFT2 merged checkpoint family that appears in the historical Pred-only run args.json
# for the cleanest apples-to-apples comparison across GT-only / Pred-only / Pred->GT.
export SFT2_CKPT="/datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/SFT_Q2/stage2_q2_lora_from_base_gt_train/v1-20260303-002509/checkpoint-486-merged"
# For strict apples-to-apples comparison with GT-only, prefer raw GRPO2 checkpoint directories here
# (not merged exports), if they still exist.
# Replace these with the raw checkpoint paths from the original training runs if available.
#
# Example raw paths you want:
# export GRPO2_PRED_ONLY_CKPT="/datasets/work/.../GRPO-2_Q2_pred_only/.../checkpoint-1400"
# export GRPO2_PRED_GT_CKPT="/datasets/work/.../GRPO-2_Q2_gt_from_predmerged/.../checkpoint-4900"
#
# Current values below are merged paths from your notes. They work for inference, but are slightly less
# consistent with the raw-checkpoint GT-only row.
export GRPO2_PRED_ONLY_CKPT="/datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/GRPO-2_Q2_pred_only/v1-20260303-111455/v0-20260303-111538/checkpoint-1400-merged"
export GRPO2_PRED_GT_CKPT="/datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/GRPO-2_Q2_gt_from_predmerged/v6-20260303-213206/v0-20260303-213248/checkpoint-4900-merged"

# This path is kept only as a historical note from the cleaner method abstraction.
# The verified checkpoint provenance for the existing Q2 schedule runs is:
#   Pred-only base/model = SFT2 merged checkpoint
#   Pred->GT base/model  = Pred-only merged checkpoint
# so the GT-only row below should also start from SFT2 merged for consistency with the saved runs.
export Q2_BASE_MODEL="/datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/GRPO-1/base_q1_merged/"


# ============================================================
# 1) GT-only: train a GT-only GRPO2 checkpoint
# ============================================================
# This row does not exist yet in your provided checkpoints.
# It starts from the verified SFT2 merged checkpoint used by the historical Pred-only run,
# skips the prediction warmup phase, trains on the Q2 train split,
# and is then evaluated directly from the raw checkpoint on the Q2 val split.

RUN_TAG=gt_only_train \
BASE_MODEL_ID="${SFT2_CKPT}" \
GRPO2_GT_JSON_IN="${Q2_TRAIN_JSON}" \
GRPO2_GT_JSON_SWIFT="${Q2_TRAIN_JSON}" \
GRPO2_GT_PREBUILT=1 \
USE_PRED_PHASE=0 \
PRED_ONLY=0 \
OUTPUT_DIR_BASE="/datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/GRPO-2_Q2_gt_only" \
bash examples/custom/interspeech_pipeline/scripts/04_stage3_grpo2_curriculum.sh

# After training finishes, choose the final checkpoint directory from:
# /datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/GRPO-2_Q2_gt_only/gt_only_train/checkpoint-*
#
# Example:
# export GRPO2_GT_ONLY_CKPT="/datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/GRPO-2_Q2_gt_only/gt_only_train/checkpoint-600"
#
# To list checkpoints:
# find /datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/GRPO-2_Q2_gt_only/gt_only_train -maxdepth 1 -type d -name 'checkpoint-*' | sort -V


# ============================================================
# 2) GT-only: oracle Q2 eval
# ============================================================

RUN_TAG=gt_only_eval \
MODEL_ID="${GRPO2_GT_ONLY_CKPT}" \
META_JSON="${Q2_VAL_JSON}" \
OUTPUT_BASE_DIR="/datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/q2_schedule_eval" \
bash examples/custom/interspeech_pipeline/scripts/06_run_baseline_infer_q2_eval.sh


# ============================================================
