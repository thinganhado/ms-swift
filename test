# ============================================================
# If the raw checkpoint still exists, prefer setting GRPO2_PRED_ONLY_CKPT to:
# /datasets/work/dss-deepfake-audio/work/data/datasets/interspeech/final_run/GRPO-2_Q2_pred_only/.../checkpoint-1400

RUN_TAG=pred_only_eval \
MODEL_ID="${GRPO2_PRED_ONLY_CKPT}" \
